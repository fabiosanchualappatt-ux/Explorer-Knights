<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explorer Knights | Roblox Rivals Clan</title>
    <meta name="description" content="EXPLORER KNIGHTS is recruiting skilled, active & competitive Roblox Rivals players. Review our requirements and prove your worth.">
    <style>
        :root {
            --bg-color: #0b0c10;
            --container-bg: #1f2833;
            --primary-color: #66fcf1;
            --text-color: #c5c6c7;
            --accent-color: #45f3ff;
            --border-color: #2f3e46;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .clan-card {
            background-color: var(--container-bg);
            border: 2px solid var(--border-color);
            border-radius: 12px;
            max-width: 650px;
            width: 100%;
            padding: 30px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
            text-align: center;
        }

        h1 {
            color: #fff;
            font-size: 1.8rem;
            letter-spacing: 2px;
            margin-bottom: 15px;
            text-transform: uppercase;
        }

        .subtitle {
            color: var(--primary-color);
            font-weight: bold;
            font-size: 1.1rem;
            margin-bottom: 5px;
            letter-spacing: 1px;
        }

        .game-tag {
            font-size: 0.9rem;
            color: #858585;
            margin-bottom: 25px;
            font-weight: 600;
        }

        .quote {
            font-style: italic;
            border-left: 4px solid var(--primary-color);
            border-right: 4px solid var(--primary-color);
            padding: 10px 20px;
            margin: 20px 0;
            background: rgba(102, 252, 241, 0.05);
            color: #fff;
        }

        .intro-text {
            margin-bottom: 25px;
            font-size: 1.05rem;
        }

        .divider {
            border: 0;
            height: 1px;
            background: linear-gradient(to right, transparent, var(--border-color), transparent);
            margin: 25px 0;
        }

        h2 {
            color: #fff;
            font-size: 1.3rem;
            margin-bottom: 15px;
            letter-spacing: 1px;
        }

        ul {
            list-style: none;
            text-align: left;
            display: inline-block;
            margin-bottom: 10px;
        }

        ul li {
            margin-bottom: 10px;
            font-size: 1.05rem;
        }

        ul li strong {
            color: var(--primary-color);
        }

        .victories-box {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            padding: 15px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-family: monospace;
            word-break: break-word;
            line-height: 1.8;
            color: #a5a6a7;
        }

        .cta-section {
            margin: 25px 0;
        }

        .btn {
            display: inline-block;
            background-color: var(--primary-color);
            color: #0b0c10;
            text-decoration: none;
            padding: 12px 30px;
            font-weight: bold;
            border-radius: 6px;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(102, 252, 241, 0.2);
        }

        .btn:hover {
            background-color: #fff;
            box-shadow: 0 4px 20px rgba(255, 255, 255, 0.4);
            transform: translateY(-2px);
        }

        .stats-footer {
            font-size: 0.9rem;
            color: #858585;
            margin-top: 15px;
        }

        .motto-box {
            margin-top: 25px;
            font-weight: bold;
        }

        .motto-box p {
            margin-bottom: 5px;
        }

        .highlight-gold {
            color: #ffb703;
        }
    </style>
</head>
<body>

    <div class="clan-card">
